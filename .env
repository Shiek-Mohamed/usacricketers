DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Email infrastructure (Phase 1A, Task 10) ───
# Get a free key at https://resend.com (free tier = 100 emails/day).
# When RESEND_API_KEY is empty, emails are logged to console in dev-mode
# so the verification flow can be tested without real delivery.
RESEND_API_KEY=
# From address — must be a verified sender in your Resend dashboard when
# you go live. Defaults to the Resend sandbox sender if not set.
FROM_EMAIL=USACricketers <onboarding@resend.dev>
# Public base URL of the site — used to build absolute links in emails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
