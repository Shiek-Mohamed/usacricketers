// Cricket CMS schema - inspired by ESPNcricinfo

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  imageUrl    String?
  imageCaption String?
  category    String   @default("news") // news, feature, analysis, interview, opinion
  author      String   @default("ESPNcricinfo staff")
  tags        String   @default("")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([published, publishedAt])
  @@index([featured, publishedAt])
}

model Team {
  id           String   @id @default(cuid())
  name         String
  shortName    String
  country      String
  primaryColor String   @default("#1e3a8a")
  accentColor  String   @default("#f59e0b")
  logoUrl      String?
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  players      Player[]
  matchesAsT1  Match[]  @relation("Team1Matches")
  matchesAsT2  Match[]  @relation("Team2Matches")
  tournamentTeams TournamentTeam[]
}

model Player {
  id            String   @id @default(cuid())
  name          String
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role          String   @default("Batsman") // Batsman, Bowler, All-rounder, Wicket-keeper
  // Explicit captain / keeper flags — used by the live scorer + scorecard to
  // render the (c) / † suffixes. (Previously regex'd from `role`, which was
  // brittle: a player whose role is "Batsman" can also be captain.)
  isCaptain     Boolean  @default(false)
  isKeeper      Boolean  @default(false)
  battingStyle  String   @default("Right-hand bat")
  bowlingStyle  String   @default("")
  battingStats  String   @default("{}") // JSON
  bowlingStats  String   @default("{}") // JSON
  bio           String   @default("")
  imageUrl      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teamId])
  @@index([role])
}

model Series {
  id          String   @id @default(cuid())
  name        String
  shortName   String
  format      String   @default("ODI") // Test, ODI, T20I
  season      String   @default("2024-25")
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ongoing") // upcoming, ongoing, completed
  description String   @default("")
  matches      Match[]
  tournamentTeams TournamentTeam[]
  scorerAssignments ScorerAssignment[]
  leagueAdminAssignments LeagueAdminAssignment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Join table: which teams participate in a tournament/league (Series).
model TournamentTeam {
  id        String   @id @default(cuid())
  seriesId  String
  teamId    String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([seriesId, teamId])
  @@index([seriesId])
}

model Match {
  id          String   @id @default(cuid())
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  team1Id     String
  team1       Team     @relation("Team1Matches", fields: [team1Id], references: [id])
  team2Id     String
  team2       Team     @relation("Team2Matches", fields: [team2Id], references: [id])
  format      String   @default("ODI") // Test, ODI, T20I
  matchNo     String   @default("1st Match")
  status      String   @default("upcoming") // upcoming, live, completed, abandoned
  venue       String
  city        String   @default("")
  startDate   DateTime
  result      String   @default("")
  manOfMatch  String?
  // Match officials — on-field umpires + TV umpire + match referee. Plain
  // strings (no relation to a Player/Person model) since officials are
  // usually independent of the players table. Format:
  //   umpires: "Umpire One, Umpire Two"
  //   tvUmpire: "TV Umpire Name"
  //   referee: "Match Referee Name"
  umpires     String   @default("")
  tvUmpire    String   @default("")
  referee     String   @default("")
  scorecard   String   @default("") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, startDate])
  @@index([seriesId])
  @@index([team1Id])
  @@index([team2Id])
}

// Admin-managed custom widgets that render into the inner-page sidebars.
// `placement` is "all" or a comma-separated list of page types
// (article,match,player,team,series). `content` is markdown.
model SidebarBlock {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  placement  String   @default("all")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

// Photo galleries — a collection of images with captions, browsable on the
// public Photos page. `photos` is a JSON string array of {src, caption} objects.
model Gallery {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  coverImage  String   @default("")
  photos      String   @default("[]") // JSON: [{src, caption}]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

// Videos — supports both uploaded files (mp4/webm saved to /uploads/videos/)
// and YouTube embeds (youtubeId stored; thumbnail auto-derived).
model Video {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description   String   @default("")
  source       String   @default("youtube") // "youtube" | "upload"
  videoUrl     String   // YouTube embed URL or local /uploads/videos/file.mp4
  youtubeId    String   @default("") // extracted ID (for thumbnail + player)
  thumbnailUrl String   @default("") // custom thumbnail (uploads); auto-derived for YouTube
  duration     String   @default("") // display string e.g. "5:32"
  category     String   @default("Highlights") // Highlights, Interviews, Analysis, etc.
  author       String   @default("USA Cricketers")
  tags         String   @default("")
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([category, publishedAt])
  @@index([featured, publishedAt])
}

// Tier 1 — Site administrators. Full god-mode CMS access (gated by the
// requireSiteAdmin cookie guard on every /api/* admin route). Distinct from
// league admins (Tier 2) and scorers (Tier 3) — those use scoped Bearer
// tokens; site admins use an httpOnly signed-cookie session.
model SiteAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   // scrypt hash (salt embedded as "salt:hash" hex)
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// Per-scorer accounts for the live scoring add-on. Each scorer is scoped to
// one or more tournaments (Series) via ScorerAssignment. Scorers never get
// access to the admin CMS — they only see/score matches in their tournaments.
model Scorer {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String   // scrypt hash (salt embedded as "salt:hash" hex)
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignments  ScorerAssignment[]

  @@index([active])
}

// Join: a scorer can be assigned to many tournaments, and a tournament can
// have many scorers. Only scorers with an assignment to a match's Series may
// push live state for that match.
model ScorerAssignment {
  id        String   @id @default(cuid())
  scorerId  String
  seriesId  String
  scorer    Scorer   @relation(fields: [scorerId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([scorerId, seriesId])
  @@index([seriesId])
}

// Tier 3 — League administrators. A league admin logs in (own account, NOT the
// site admin), creates leagues (Series), schedules matches within their
// leagues, and assigns scorer accounts to their leagues. Scoped to their own
// leagues only — never sees other leagues or the site-wide CMS.
model LeagueAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String   // scrypt hash (salt embedded as "salt:hash" hex)
  name         String
  active       Boolean  @default(true)
  // Email verification: null until the league admin clicks the verification
  // link sent to their email at signup. Login is blocked while null — the
  // /api/league-admin/login route returns 403 with code "EMAIL_NOT_VERIFIED".
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignments  LeagueAdminAssignment[]

  @@index([active])
}

// Join: a league admin manages one or more leagues (Series). When a league
// admin creates a new Series, an assignment is auto-created so they own it.
model LeagueAdminAssignment {
  id        String   @id @default(cuid())
  adminId   String
  seriesId  String
  admin     LeagueAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  series    Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adminId, seriesId])
  @@index([seriesId])
}

// Advertising banners — three kinds via the `type` discriminator:
//   • "image"   — classic image banner with click-through (tracked via /click redirect)
//   • "adsense" — Google AdSense ad unit (loader script + <ins> + push)
//   • "html"    — raw HTML snippet (affiliate iframes, sponsored tags, custom)
//
// Multiple banners sharing the same `placement` form the rotation pool for
// that slot — the client picks one (random weighted, optionally time-
// rotating). AdSense banners never time-rotate (Google TOS).
model Banner {
  id           String    @id @default(cuid())
  type         String    @default("image") // "image" | "adsense" | "html"
  title        String
  placement    String    @default("home-live-hero")
  order        Int       @default(0)
  published   Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  weight       Int       @default(1) // higher = more likely to be picked

  // type="image"
  imageUrl     String?
  linkUrl      String?
  altText      String?

  // type="adsense"
  adsenseClient String? // ca-pub-XXXXXXXXXXXXXXXX (publisher ID, same across all your ads)
  adsenseSlot   String? // 1234567890 (slot ID, unique per ad unit)
  adsenseFormat String? // "auto" | "horizontal" | "vertical" | "rectangle"
  responsive    Boolean  @default(true)

  // type="html"
  htmlContent  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, placement, order])
}

// League standings — auto-updated when a match in a series completes.
// One row per (series, team) pair. The Standings component reads this
// instead of the hardcoded values it used before.
model Standing {
  id        String   @id @default(cuid())
  seriesId  String
  teamId    String
  played    Int      @default(0)
  won       Int      @default(0)
  lost      Int      @default(0)
  tied      Int      @default(0)
  nrr       Float    @default(0) // net run rate (simplified: (runs/overs) - (opponent_runs/opponent_overs))
  points    Int      @default(0) // typically 2 per win, 1 per tie, 0 per loss
  forRuns   Int      @default(0) // total runs scored across innings
  forOvers  Float    @default(0) // total overs faced (decimal — e.g. 42.4 = 42.67)
  againstRuns  Int   @default(0) // total runs conceded
  againstOvers Float @default(0) // total overs bowled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, teamId])
  @@index([seriesId])
}
